def inspeccion_gráfica(data):
    # Seleccionamos solo las columnas numéricas del DataFrame
    data_numeric = data.select_dtypes(include=['number'])

    # Configurar el tamaño de la figura para que se acomoden varias gráficas
    plt.figure(figsize=(12, len(data_numeric.columns) * 4))  # Asegura que haya suficiente espacio vertical

    # Crear un boxplot para cada variable numérica
    for i, column in enumerate(data_numeric.columns, 1):
        # Cambiar la configuración de subplot para que las gráficas estén en una sola columna
        plt.subplot(len(data_numeric.columns), 1, i)  # Una columna y varias filas
        sns.boxplot(x=data_numeric[column], color='skyblue', width=0.5)
        plt.title(f'Boxplot de {column}')

    # Ajusta el diseño para que no se solapen las gráficas
    plt.tight_layout()

    # Mostrar las gráficas
    plt.show()

