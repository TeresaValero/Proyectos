# PASO 5 CORRELACIONES

def correlaciones(data):
    # Selecciona las variables numéricas del dataframe 
    data_numeric = data.select_dtypes(include=['number'])

    # Calcula la matriz de correlaciones entre todas las variables numéricas
    correlation_matrix = data_numeric.corr()
    
    # Muestra la matriz de correlaciones en consola
    print(correlation_matrix)

    # Verificar si estamos en un entorno interactivo (por ejemplo, Jupyter Notebook)
    if '__file__' in globals():
        # Si estamos en un script normal, usamos __file__ para obtener la ruta
        current_dir = os.path.dirname(os.path.abspath(__file__))
    else:
        # Si estamos en un entorno interactivo, usamos el directorio de trabajo actual
        current_dir = os.getcwd()

    # Definir la ruta de salida del archivo CSV en la misma carpeta que el script
    output_path = os.path.join(current_dir, 'correlation_matrix.csv')

    # Asegura que la ruta de salida exista, si no, la crea
    if not os.path.exists(current_dir):
        os.makedirs(current_dir)

    # Guarda la matriz de correlaciones en un archivo .csv
    correlation_matrix.to_csv(output_path)
    
    # Mostrar la ruta donde se ha guardado el archivo
    print(f"La matriz de correlación se ha guardado en: {os.path.abspath(output_path)}")

    # Configurar el tamaño de la figura
    plt.figure(figsize=(10, 8))

    # Crear la gráfica de calor (heatmap)
    sns.heatmap(correlation_matrix, annot=True, cmap='coolwarm', fmt='.2f', linewidths=0.5)

    # Añadir título
    plt.title('Matriz de Correlaciones')

    # Mostrar la gráfica
    plt.show()

# Llamada a la función
correlaciones(data)

