import pandas as pd
from sklearn.impute import IterativeImputer

def muestra_na(data):  
    # Identificar las columnas con NA
    x_na_list = data.columns[data.isnull().sum() > 0]
    
    if len(x_na_list) > 0:
        # Mostrar las columnas con NA y sus tipos
        na_info = {}
        for column in x_na_list:
            na_info[column] = str(data[column].dtype)
        
        # Imprimir las columnas con NA y su tipo
        print("Las variables donde existen NA son:")
        for column, dtype in na_info.items():
            print(f"Columna: {column}, Tipo: {dtype}")
        
        # Crear la lista con las columnas que contienen NA
        return x_na_list.tolist(), na_info
    else:
        print("No se encontraron columnas con NA.")
        return [], {}
    
# Función interna para tratar las variables con valores NA
def tratamiento_na_columna(df, columna, tipo):
    if tipo == 'media':
        # Reemplazar NA con la media para variables numéricas
        if df[columna].dtype in ['float64', 'int64']:
            media = df[columna].mean()
            df[columna].fillna(media, inplace=True)
            print(f"Se han sustituido los valores NA de '{columna}' por la media: {media}")
        else:
            print(f"La columna '{columna}' no es numérica, no se puede sustituir por la media.")
    
    elif tipo == 'dummy':
        # Convertir NA en 0 y los demás en 1
        df[columna] = df[columna].apply(lambda x: 0 if pd.isna(x) else 1)
        print(f"Se han transformado los valores de '{columna}' en variables dummy (0 para NA, 1 para otros valores).")
    
    elif tipo == 'eliminar_columna':
        # Eliminar la columna
        del df[columna]
        print(f"La columna '{columna}' ha sido eliminada.")
    
    elif tipo == 'eliminar_filas':
        # Eliminar las filas donde existe NA en la columna
        df.dropna(subset=[columna], inplace=True)
        print(f"Se han eliminado las filas donde existe NA en la columna '{columna}'.")
    
    elif tipo == 'iterative_imputer':
        # Sustituir NA con IterativeImputer
        if df[columna].dtype in ['float64', 'int64']:
            imputer = IterativeImputer(max_iter=10, random_state=0)
            df[[columna]] = imputer.fit_transform(df[[columna]])
            print(f"Se han proyectado los valores NA de '{columna}' utilizando IterativeImputer.")
        else:
            print(f"La columna '{columna}' no es numérica, no se puede sustituir por IterativeImputer.")

def tratamiento_na(df):
    # Filtrar columnas con NA
    x_na_list = df.columns[df.isna().any()].tolist()

    # Opciones iniciales de limpieza
    print("\n¿Quieres eliminar las filas con cualquier NA en alguna columna del DataFrame?")
    print("1. Sí, eliminar filas con NA")
    print("2. No, continuar con el tratamiento de las columnas")
    opcion_filas = input("Introduce el número de opción (1/2): ")

    if opcion_filas == '1':
        df.dropna(inplace=True)
        print("Se han eliminado las filas con NA en cualquier columna del DataFrame.")

    # Iterar sobre cada columna de x_na_list
    for col in x_na_list:
        na_count = df[col].isna().sum()
        print(f"\nLa columna '{col}' tiene {na_count} instancias con NA.")
        
        # Identificar tipo de columna
        if df[col].dtype in ['object', 'category']:
            tipo_columna = 'categórica'
        else:
            tipo_columna = 'numérica'
        
        print(f"El tipo de la columna '{col}' es {tipo_columna}.")
        
        # Preguntar al usuario qué hacer con la columna
        if tipo_columna == 'numérica':
            print("¿Qué deseas hacer con la columna numérica?")
            print("1. Sustituir los valores NA por la media")
            print("2. Sustituir los valores NA utilizando IterativeImputer")
            print("3. Eliminar las filas con NA en esta columna")
            print("4. Transformar en dummy (NA será 0 y el resto 1)")
            print("5. Eliminar la columna")
        else:
            print("¿Qué deseas hacer con la columna categórica?")
            print("1. Transformar en dummy (NA será 0 y el resto 1)")
            print("2. Eliminar la columna")
            print("3. Eliminar las filas con NA en esta columna")

        opcion = input("Introduce el número de opción (1/2/3/4/5): ")

        if opcion == '1':
            if tipo_columna == 'numérica':
                tratamiento_na_columna(df, col, 'media')
            else:
                tratamiento_na_columna(df, col, 'dummy')
        elif opcion == '2':
            if tipo_columna == 'numérica':
                tratamiento_na_columna(df, col, 'iterative_imputer')
            else:
                tratamiento_na_columna(df, col, 'eliminar_columna')
        elif opcion == '3':
            tratamiento_na_columna(df, col, 'eliminar_filas')
        elif opcion == '4':
            if tipo_columna == 'numérica':
                tratamiento_na_columna(df, col, 'dummy')
            else:
                print("Opción no válida para columna categórica.")
        elif opcion == '5':
            tratamiento_na_columna(df, col, 'eliminar_columna')
        else:
            print("Opción no válida. No se hizo ningún cambio en la columna.")

    # Mostrar el DataFrame modificado
    print("\nDataFrame después de las modificaciones:")
    print(df)

    print("El tratamiento de las variables con NA se ha realizado con éxito.")

